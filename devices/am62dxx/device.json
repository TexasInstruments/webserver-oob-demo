{
  "id": "am62dxx",
  "ui": "vue",
  "displayName": "AM62D",
  "boards": [
    {
      "name": "SK-AM62D",
      "description": "Starter Kit for AM62D processors — expandable audio platform with quad Cortex-A53 and C7x DSP, optimized for premium audio processing, noise reduction, and AI-powered speech enhancement.",
      "image": "images/sk-am62d-angled.png"
    }
  ],
  "soc": "AM62Dx quad Cortex-A53 @ 1.4GHz + C7x DSP",
  "demos": ["cpu-monitor", "tvm-inference", "audio-classification", "speech-enhancement", "audio-offload", "2dfft", "sigchain-biquad", "gst-pipeline"],
  "demoConfig": {
    "audio-classification": {
      "edgeAiBinary": "/usr/bin/rpmsg_inference_example",
      "defaultModel": "yamnet",
      "models": {
        "yamnet": {
          "label": "YAMNet",
          "jsonFile": "/usr/share/tvm_inference/json/pipeline_audio_classification_yamnet.json",
          "description": "521 AudioSet classes · MobileNet v1"
        },
        "vggish": {
          "label": "VGGish",
          "jsonFile": "/usr/share/tvm_inference/json/pipeline_audio_classification_vggish.json",
          "description": "10 UrbanSound8K classes · VGGish features"
        }
      },
      "inputPath": "/usr/share/tvm_inference/input/input_audio.wav",
      "captureSeconds": 1,
      "sampleRate": 16000,
      "preloadTvm": false
    },
    "2dfft": {
      "binPath": "/usr/bin/rpmsg_2dfft_example"
    },
    "audio-offload": {
      "binPath": "/usr/bin/rpmsg_audio_offload_example",
      "host": "127.0.0.1"
    },
    "sigchain-biquad": {
      "binPath": "/usr/bin/rpmsg_sigchain_biquad_example"
    },
    "speech-enhancement": {
      "edgeAiBinary": "/usr/bin/rpmsg_inference_example",
      "tvmDir": "/usr/share/tvm_inference",
      "jsonFile": "json/pipeline_speech_enhancement.json",
      "artifactsPath": "artifacts",
      "inputPath": "/usr/share/tvm_inference/input/input_audio.wav",
      "streamSocket": "/tmp/edge-ai-speech.sock",
      "outputName": "processed_output.wav"
    },
    "gst-pipeline": {
      "artifactsDir": "/usr/share/tvm_inference/artifacts",
      "inputDir":     "/usr/share/tvm_inference/input"
    },
    "tvm-inference": {
      "edgeAiBinary": "/usr/bin/rpmsg_inference_example",
      "jsonFile": "/usr/share/tvm_inference/json/pipeline_tvm_inference.json",
      "modelName": "GCRN",
      "description": "Hardware-accelerated inference using TVM+TIDL on C7x DSP"
    }
  },
  "docs": {
    "subtitle": "Everything you need to develop with AM62D Sitara processors",
